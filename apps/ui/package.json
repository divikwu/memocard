{
  "name": "@memocard/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:states": "vite --config vite.preview-next.config.ts",
    "dev:states:ui-next": "vite --config vite.preview-next.config.ts",
    "build:states:ui-next": "vite build --config vite.preview-next.config.ts",
    "typecheck:states:ui-next": "tsc --project tsconfig.preview-next.json --noEmit",
    "test:states:ui-next": "vitest run --config vite.storybook-next.config.ts preview/ --maxWorkers=3",
    "typecheck:ui-next": "tsc --project tsconfig.ui-next.json --noEmit",
    "storybook:ui-next": "storybook dev --config-dir .storybook-next --host 127.0.0.1 --port 6016 --exact-port --no-open --disable-telemetry",
    "build:storybook:ui-next": "storybook build --config-dir .storybook-next --output-dir storybook-next-static --disable-telemetry",
    "prebuild": "pnpm -w tokens:build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm test:shared && pnpm test:ui-next",
    "test:ui-next": "vitest run --config vite.storybook-next.config.ts --maxWorkers=4",
    "storybook": "storybook dev --config-dir .storybook-next --host 127.0.0.1 --port 6016 --exact-port --no-open --disable-telemetry",
    "prestorybook": "pnpm -w tokens:build && pnpm -w icons:build && pnpm -w spacing:build && pnpm -w typography:build",
    "build:storybook": "storybook build --config-dir .storybook-next --output-dir storybook-next-static --disable-telemetry",
    "prebuild:storybook": "pnpm -w tokens:build && pnpm -w icons:build && pnpm -w spacing:build && pnpm -w typography:build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "typecheck:storybook": "tsc --project tsconfig.storybook.json --noEmit",
    "dev:web-next": "pnpm dev",
    "build:web-next": "pnpm build",
    "test:shared": "vitest run --maxWorkers=4 --exclude 'ui-next/**'"
  },
  "dependencies": {
