    "smoke": "node src/smoke.ts"
  },
  "dependencies": {
    "@memocard/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
